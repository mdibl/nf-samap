{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/scscape/master/assets/schema_input_blast.json",
    "title": "BLAST-only input schema",
    "description": "Schema for BLAST map generation",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string"
            },
            "type": {
                "type": "string"
            },
            "fasta": {
                "type": "string",
                "format": "file-path"
            }
        },
        "required": ["id","type", "fasta"]
    }
}