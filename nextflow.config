// nextflow.config

// ----------------------------------------------------------------------------
// Parameters
// ----------------------------------------------------------------------------
params {
    // ----- Control Flow -----
    run_id              = null
    publish_dir_mode    = 'copy'

    // ----- Input -----
    sample_sheet        = 'sample_sheet.csv'
    maps_dir            = null
    var_genes           = 3000

    // ----- Output -----
    outdir              = 'out'
    results_dir         = 'results' // remove this after refactor
    work_dir            = 'work'
    create_loupe        = 'false'

    // ----- Containers ------
    container_blast     = 'mdiblbiocore/samap-blast:latest'
    container_samap     = 'mdiblbiocore/samap:latest'
    container_loupe     = 'mdiblbiocore/seurat:latest'

    eula10x             = "Agree"
}

// ----------------------------------------------------------------------------
// Profiles
// ----------------------------------------------------------------------------

docker.enabled = true



profiles {
    test {
        process {
            cpus = 1
            memory = '8 GB'
            time = '10m'
        }
    }
    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64 -v $HOME:$HOME'

        process {
            withName: 'PREPROCESS_SEURAT_OBJECT' {
                cpus = 2
                memory = '4 GB'
                time = '4h'
            }
            withName: 'PREPROCESS_ANNDATA_OBJECT' {
                cpus = 8
                memory = '16 GB'
                time = '4h'
            }      
            withName: 'RUN_BLAST_PAIR' {
                cpus = 64
                time = '24h'
            }
            withName: 'LOAD_SAMS' {
                cpus = 4
                memory = '16 GB'
            }      
            //withName: 'BUILD_SAMAP' {
            //    cpus = 8
            //    time = '12h'
            //}   
            withName: 'RUN_SAMAP' {
                cpus = 32
                time = '12h'
            }   
            withName: 'CONNECTED_DE' {
                cpus = 4
                memory = '16 GB'
            }
            withName: 'ADDITIONAL_ANALYSIS' {
                cpus = 4
                memory = '16 GB'
            }        
        }
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    cluster {
        process {
            cpus = 8
            memory = '8 GB'
            time = '12h'
        }
    }

    worm {
        process {
            withName: 'PREPROCESS_SEURAT_OBJECT' {
                cpus = 2
                memory = '4 GB'
                time = '4h'
            }   
            withName: 'RUN_BLAST_PAIR' {
                cpus = 64
                time = '24h'
            }
            withName: 'LOAD_SAMS' {
                cpus = 4
                memory = '16 GB'
            }      
            withName: 'BUILD_SAMAP' {
                cpus = 8
                memory = 32
                time = '12h'
            }   
            withName: 'RUN_SAMAP' {
                cpus = 32
                time = '12h'
            }      
        }
    }

}
docker.registry      = 'docker.io'
// ----------------------------------------------------------------------------
// Process Defaults
// ----------------------------------------------------------------------------
process {
    withName: 'PREPROCESS_SEURAT_OBJECT' {
        publishDir = [
            path: { "${params.outdir}/preprocess_seurat_object" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
    withName: 'PREPROCESS_ANNDATA_OBJECT' {
        publishDir = [
            path: { "${params.outdir}/preprocess_anndata_object" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }      
    withName: 'PREPROCESS_SAM_OBJECT' {
        publishDir = [
            path: { "${params.outdir}/preprocess_sam_object" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }   
    withName: 'RUN_BLAST_PAIR' {
        publishDir = [
            path: { "${params.outdir}/blast" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
       
    } 
    withName: 'LOAD_SAMS' {
        publishDir = [
            path: { "${params.outdir}/load_sams" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }      
    withName: 'BUILD_SAMAP' {
        publishDir = [
            path: { "${params.outdir}/build_samap" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }   
    withName: 'RUN_SAMAP' {
        publishDir = [
            path: { "${params.outdir}/run_samap" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
       
    }   
    withName: 'SUMMARY_SAMAP' {
    publishDir = [
        path: { "${params.outdir}/Analysis/AnalysisResults/${id1}-${id2}" },
        mode: params.publish_dir_mode ?: 'copy',
        saveAs: { filename -> (filename == 'versions.yml' || filename == 'analysis.pkl' || filename == 'samap_results_Cleaned.pkl') ? null : filename }
        ]
    }
    withName: 'CONNECTED_DE' {
        publishDir = [
            path: { "${params.outdir}/Analysis/Grouping_Analysis/${id1}-${id2}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename }
        ]
    }
    withName: 'ADDITIONAL_ANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/Analysis/AnalysisResults/${id1}-${id2}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> (filename == 'versions.yml' || filename == 'analysis.pkl' || filename == 'samap_results_Cleaned.pkl') ? null : filename }
        ]
        stageInMode = 'copy'
    }
    withName: 'CREATE_LOUPE_INPUT' {
        publishDir = [
            path: { "${params.outdir}/Analysis/Loupe/${id1}-${id2}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> (filename == 'versions.yml') ? null : filename }
        ]
        stageInMode = 'copy'
    }
    withName: 'CREATE_LOUPE_FILE' {
        publishDir = [
            path: { "${params.outdir}/Analysis/Loupe/${id1}-${id2}" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> (filename == 'versions.yml') ? null : filename }
        ]
        stageInMode = 'copy'
    }
    withName: 'NONPAIRWISE_ANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/Analysis/NonPairwise" },
            mode: params.publish_dir_mode ?: 'copy',
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
        
    }        
}
