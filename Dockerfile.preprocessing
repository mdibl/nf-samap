# ========== Stage 1: pull SAMap container ==========
FROM mdiblbiocore/samap:latest AS source

# ========== Stage 2: Base clean R container ==========
FROM rocker/r-base:4.2.3

# --- System dependencies for compiled R + python libs ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libblas-dev \
    liblapack-dev \
    libgfortran5 \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    libhdf5-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy R libraries as-is from SAMap image
COPY --from=source /usr/local/lib/R/site-library /usr/local/lib/R/site-library
COPY --from=source /usr/lib/R/site-library       /usr/lib/R/site-library
COPY --from=source /usr/lib/R/library            /usr/lib/R/library

# Copy your scripts INTO the final image (stage 2)
COPY scripts/log_utils.py /usr/local/bin/log_utils.py
COPY scripts/preprocess_seurat_object.R /usr/local/bin/preprocess_seurat_object.R
COPY scripts/preprocess_anndata_object.py /usr/local/bin/preprocess_anndata_object.py
RUN chmod -R +x /usr/local/bin/*

# Make python3 the default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

# Upgrade pip only once
RUN python -m pip install --upgrade pip

# Install specific pinned versions of scientific python packages
RUN pip install \
    anndata==0.7.8 \
    scanpy==1.9.3 \
    numpy==1.23.5 \
    pandas==1.4.1 \
    seaborn==0.13.2 \
    scipy \
    samalg \
    argparse \
    pathlib

WORKDIR /workspace