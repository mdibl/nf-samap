# Start from Jupyter's standard "Python + R + Julia + common data science tools" image
FROM jupyter/datascience-notebook:python-3.10

# -------------------------
# Create a non-root user
# -------------------------
USER root
RUN useradd -m -s /bin/bash msujansky \
    && mkdir -p /workspace/bin \
    && chown -R msujansky:msujansky /workspace

WORKDIR /workspace

# Switch to our user
USER msujansky
ENV HOME=/home/msujansky

# -------------------------
# Python packages (user-owned)
# -------------------------
ENV PYTHONUSERBASE=$HOME/.local
ENV PATH=$PYTHONUSERBASE/bin:$PATH

RUN python -m pip install --upgrade pip setuptools wheel --user

# Install required Python packages via pip (user-owned)
RUN python -m pip install --no-cache-dir --user \
    anndata==0.7.8 \
    scanpy==1.9.3 \
    numpy==1.23.5 \
    pandas==1.4.1 \
    matplotlib==3.8.2 \
    seaborn==0.13.2 \
    scipy==1.10.1

RUN pip install --user git+https://github.com/atarashansky/self-assembling-manifold.git
RUN pip install --user git+https://github.com/atarashansky/SAMap.git

# -------------------------
# R packages (user-owned)
# -------------------------
ENV R_LIBS_USER=$HOME/R/library
RUN mkdir -p $R_LIBS_USER

# Install CRAN packages into the user library
RUN R -e "install.packages(c('tidyverse', 'data.table'), repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"
RUN R -e "install.packages('remotes', repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"

# Install specific R package versions into user library
RUN R -e "remotes::install_version('argparse', version='2.3.1', repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"
RUN R -e "remotes::install_version('readr', version='2.1.5', repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"
RUN R -e "remotes::install_version('Seurat', version='5.0.3', repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"
RUN R -e "remotes::install_version('Matrix', version='1.6-5', repos='https://cloud.r-project.org', lib=Sys.getenv('R_LIBS_USER'))"

# -------------------------
# Copy your scripts and make them executable
# -------------------------
COPY scripts/preprocess_seurat_object.R scripts/preprocess_anndata_object.py scripts/log_utils.py /workspace/bin/
RUN chmod +x /workspace/bin/*.py /workspace/bin/*.R
ENV PATH="/workspace/bin:${PATH}"

# Set working directory
WORKDIR /workspace

# Default user
USER msujansky
