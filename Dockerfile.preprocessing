# Start from Jupyter's standard "Python + R + Julia + common data science tools" image
FROM jupyter/datascience-notebook:python-3.10

#Install Python Packages
# Install Python packages via pip (bypasses conda solver)
RUN python -m pip install --no-cache-dir \
    anndata==0.7.8 \
    scanpy==1.9.3 \
    numpy==1.23.5 \
    pandas==1.4.1 \
    matplotlib==3.8.2 \
    seaborn==0.13.2 \
    scipy==1.10.1
    

RUN pip install git+https://github.com/atarashansky/self-assembling-manifold.git
RUN pip install git+https://github.com/atarashansky/SAMap.git

# -------------------------
# Install extra R packages
# -------------------------
# These are installed into the Jupyter R kernel environment
RUN R -e "install.packages(c('tidyverse', 'data.table'), repos='https://cloud.r-project.org')"
RUN R -e "install.packages('remotes', repos='https://cloud.r-project.org')"

# Install specific R package versions
RUN R -e "remotes::install_version('argparse', version='2.3.1', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('readr', version='2.1.5', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('Seurat', version='5.0.3', repos='https://cloud.r-project.org')"
RUN R -e "remotes::install_version('Matrix', version='1.6-5', repos='https://cloud.r-project.org')"

COPY scripts/preprocess_seurat_object.R scripts/preprocess_anndata_object.py scripts/log_utils.py /home/jovyan/bin/
RUN chmod +x /home/jovyan/bin/*.py /home/jovyan/bin/*.R
ENV PATH="/home/jovyan/bin:${PATH}"

WORKDIR /workspace